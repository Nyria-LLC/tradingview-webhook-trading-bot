# Shared secret, at least 16 characters; generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=your-long-random-secret
# true = never call a broker; the response shows the request that would be sent
DRY_RUN=true
# Broker used when an alert has no "broker" field: alpaca, tradier, tastytrade or schwab
DEFAULT_BROKER=alpaca
# Largest quantity (shares) accepted in one alert
MAX_QTY=100
# Comma-separated symbols the bot may trade; empty allows every symbol
ALLOWED_SYMBOLS=
# true = a sell larger than the long position sells the position instead (Alpaca, Tradier, tastytrade)
CLAMP_SELLS=false
# Seconds a finished alert's body is remembered by the duplicate guard; 0 turns it off
DEDUPE_SECONDS=30
# true = only the addresses in TRADINGVIEW_IPS may call /webhook
TRADINGVIEW_IPS_ONLY=false
# TradingView's published webhook addresses
TRADINGVIEW_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
# Timeout in seconds for each Alpaca, Tradier and tastytrade HTTP call
BROKER_TIMEOUT_SECONDS=10
# Logging level of the tvbot logger: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# Alpaca key id (paper keys unless ALPACA_LIVE=true)
ALPACA_API_KEY_ID=
# Alpaca secret key
ALPACA_API_SECRET_KEY=
# true = https://api.alpaca.markets, false = https://paper-api.alpaca.markets
ALPACA_LIVE=false
# Tradier access token
TRADIER_ACCESS_TOKEN=
# Tradier account id
TRADIER_ACCOUNT_ID=
# true = https://api.tradier.com/v1, false = https://sandbox.tradier.com/v1
TRADIER_LIVE=false
# tastytrade OAuth client secret
TASTYTRADE_CLIENT_SECRET=
# tastytrade OAuth grant refresh token
TASTYTRADE_REFRESH_TOKEN=
# tastytrade account number
TASTYTRADE_ACCOUNT_NUMBER=
# true = https://api.tastyworks.com, false = https://api.cert.tastyworks.com
TASTYTRADE_LIVE=false
# Schwab developer app key
SCHWAB_APP_KEY=
# Schwab developer app secret
SCHWAB_APP_SECRET=
# Schwab account number
SCHWAB_ACCOUNT_NUMBER=
# Must equal the callback URL registered on the Schwab app
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Token file written by python -m tvbot.schwab_login
SCHWAB_TOKEN_PATH=schwab_token.json
# Must be true for any non-dry-run Schwab order (this bot has no Schwab paper mode)
SCHWAB_LIVE=false
# Must be true for Schwab sells, which the bot cannot check against your position
SCHWAB_ALLOW_UNCHECKED_SELLS=false
